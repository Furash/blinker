{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlinkerUI",
  "version": "0.1.0",
  "identifier": "com.fenris.blinkerui",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Blinker UI  v0.1.0",
        "width": 1100,
        "height": 820,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../../icons/": "icons/"
    }
  }
}
